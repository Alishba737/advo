# --- DashScope (Alibaba Cloud) ---
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Local Services ---
QDRANT_URL=http://localhost:6333
POSTGRES_DSN=postgresql://advo:advo@localhost:5432/advo
REDIS_URL=redis://localhost:6379

# --- Local Models ---
# EMBEDDING_PROVIDER: auto = local embeddings (GPU if available, else CPU,
#                     DashScope fallback) | local | dashscope
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# DEVICE: auto = detect GPU automatically | cuda | cpu
DEVICE=auto

# --- Voice (DashScope workspace endpoint) ---
# STT: realtime WebSocket session model + the transcription model used inside it.
# TTS: native multimodal-generation model + voice name.
VOICE_ASR_MODEL=qwen3-asr-flash-realtime
VOICE_ASR_TRANSCRIPTION_MODEL=qwen3-asr-flash
VOICE_TTS_MODEL=qwen3-tts-flash
VOICE_TTS_VOICE=Cherry
